{
  "name": "trajectory-desktop",
  "version": "0.1.0",
  "description": "Local-first, context-aware AI mentorship desktop app",
  "author": "Trajectory contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs",
    "package": "npm run build && electron-builder --dir",
    "smoke": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.7",
    "openai": "^6.48.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "40.10.6",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.trajectory.desktop",
    "productName": "Trajectory",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../examples/demo/user",
        "to": "trajectory-data/user"
      },
      {
        "from": "../resources/mentors",
        "to": "trajectory-data/mentors"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
